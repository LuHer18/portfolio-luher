---
const links = [
  ['about', 'Perfil', 'Profile', 'M12 3a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm-7 18a7 7 0 0 1 14 0'],
  ['experience', 'Experiencia', 'Experience', 'M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Zm0 4h18M10 13v2h4v-2'],
  ['projects', 'Proyectos', 'Projects', 'M4 5h6l2 2h8v12H4V5Zm0 5h16'],
  ['skills', 'Habilidades', 'Skills', 'm8 9-4 3 4 3m8-6 4 3-4 3M14 5l-4 14'],
  ['resume', 'Currículum', 'Resume', 'M6 3h9l3 3v15H6V3Zm8 0v4h4M9 11h6m-6 4h6m-6 4h4'],
  ['contact', 'Contacto', 'Contact', 'M3 5h18v14H3V5Zm0 1 9 7 9-7'],
] as const;
---

<header class="site-header" data-header>
  <nav class="dock" aria-label="Navegación principal" data-aria-es="Navegación principal" data-aria-en="Primary navigation">
    <a class="brand" href="/#home" aria-label="Luis Herrera, inicio" data-aria-es="Luis Herrera, inicio" data-aria-en="Luis Herrera, home">
      <img src="/assets/avatar-luher.webp" width="1413" height="1412" alt="" aria-hidden="true" />
    </a>
    <button class="menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="primary-menu" data-menu-button>
      <span class="menu-line" aria-hidden="true"></span><span class="menu-line" aria-hidden="true"></span><span class="menu-line" aria-hidden="true"></span>
    </button>
    <div class="nav-panel" id="primary-menu" data-menu>
      <a class="mobile-home" href="/#home" data-section-link="home">
        <img src="/assets/avatar-luher.webp" width="1413" height="1412" alt="" aria-hidden="true" />
        <span><strong>Luis Herrera</strong><small><span data-copy="es">Inicio</span><span data-copy="en">Home</span></small></span>
      </a>
      <div class="nav-links">
        {links.map(([id, es, en, path]) => (
          <a href={`#${id}`} data-section-link={id} aria-label={es} data-aria-es={es} data-aria-en={en} data-tooltip-es={es} data-tooltip-en={en}>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d={path}></path></svg>
            <span class="nav-label"><span data-copy="es">{es}</span><span data-copy="en">{en}</span></span>
            <span class="dock-tooltip" aria-hidden="true"><span data-copy="es">{es}</span><span data-copy="en">{en}</span></span>
          </a>
        ))}
      </div>
      <div class="dock-controls">
        <button class="dock-button theme-button" type="button" aria-label="Activar modo claro" data-theme-button>
          <svg data-theme-icon="light" aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
          <svg data-theme-icon="dark" aria-hidden="true" viewBox="0 0 24 24"><path d="M20.2 15.1A8.5 8.5 0 0 1 8.9 3.8 8.5 8.5 0 1 0 20.2 15.1Z"></path></svg>
          <span class="mobile-control-label"><span data-copy="es">Tema</span><span data-copy="en">Theme</span></span>
        </button>
        <button class="dock-button language-button" type="button" data-language aria-label="Cambiar idioma" data-aria-es="Cambiar idioma" data-aria-en="Change language">
          <span aria-hidden="true">ES</span><span class="language-divider" aria-hidden="true">/</span><span aria-hidden="true">EN</span>
        </button>
      </div>
    </div>
  </nav>
</header>
